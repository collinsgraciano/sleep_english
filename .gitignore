# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Config with secrets (keep default but ignore user presets with keys)
configs/*.local.json
configs/llm_providers.json
configs/page_mcp_tokens.json

# Runtime mode/default configs contain real API keys & MCP tokens — never commit
configs/default.json
configs/mode_*.json

# Generated audio previews / voice assets
configs/voice_previews/
configs/custom_voices/
configs/moss_previews/
configs/moss_voices/
configs/script_library/
configs/style_previews/

# Batch queue runtime state (console batch video generation)
configs/batch_queue.json

# AI test playground state (system prompt)
configs/ai_test_config.json

# Quick-config panel field selection per mode (console user preference)
configs/quick_config.json

# Font scan disk cache for config-page dropdown (machine-specific paths)
configs/font_scan_cache.json

# Intro video library (sleep mode 10s intros, generated assets)
configs/intro_videos/
configs/intro_library.json

# Sleep color combo presets (config page random palette saves)
configs/sleep_color_presets/

# Channel matrix runtime state (channel entities + per-channel topic pools)
configs/channels/

# Pipeline run outputs
output/

# 预生成脚本库：只入库成品（manifest.json + NNN_Topic/script.json）。
# _ / . 前缀的都是机器本地产物或生成过程工作文件（.llm_cache LLM 批次缓存、
# _parts 分片中间件、_review 交叉审查、_audit 体检、_research 调研、
# _existing_lines.txt 防重行库、_recycle_bin 管理页删除项），代码本身也一律跳过 _ 前缀目录。
ai_scripts*/.*
ai_scripts*/_*
# 主题目录里的断点文件记的是本机 run 路径，且没有任何代码读它
ai_scripts*/*/checkpoint.json

# Atlas split test outputs (manual verification only)
test/split_test_output/

# Copyright BGM music library (user-provided audio files)
bgm_music/
bgm_music_60s/

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/

# Codely CLI
.codely-cli/
